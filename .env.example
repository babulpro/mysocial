# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_DB_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT — use a long random string in production (e.g. openssl rand -base64 32)
JWT_SECRET=your_strong_random_secret_here
JWT_EXPIRES_IN=7d
JWT_ISSUER=social-management-api

# CORS — your Next.js frontend URL (e.g. https://your-app.vercel.app)
CLIENT_URL=http://localhost:3000
